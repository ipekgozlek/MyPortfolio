                    </a>
                    <a href="#about" class="smoothscroll btn btn--stroke">
                        ABOUT ME
                    </a>
                </div>

                <div class="home-content__scroll">
                    <a href="#about" class="scroll-link smoothscroll">
                        <span>SCROLL TO EXPLORE</span>
                    </a>
                </div>

            </div>

        </div>
    }

   
    <!-- end home-content -->

    <ul class="home-social">
        <li>
            <a href="https://www.linkedin.com/in/ipek-sertel/" target="_blank" rel="noopener noreferrer"><i class="im im-linkedin" aria-hidden="true"></i><span>LINKEDIN</span></a>
        </li>
        <li>
            <a href="https://github.com/ipekgozlek" target="_blank" rel="noopener noreferrer"><i class="im im-github" aria-hidden="true"></i><span>GITHUB</span></a>
        </li>
      @*   <li>
            <a href="#"><i class="im im-instagram" aria-hidden="true"></i><span>Instagram</span></a>
        </li>
        <li>
            <a href="#"><i class="im im-behance" aria-hidden="true"></i><span>Behance</span></a>
        </li>
        <li>
            <a href="#"><i class="im im-pinterest" aria-hidden="true"></i><span>Pinterest</span></a>
        </li> *@
