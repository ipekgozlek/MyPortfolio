@model List<MyPortfolio.DAL.Entities.Feature>
<section id="home" class="s-home page-hero target-section" data-parallax="scroll" data-image-src="@Url.Content("~/hola-master/images/134234885277465061.jpg")" data-natural-width=3000 data-natural-height=2000 data-position-y=center>

    <div class="overlay"></div>
    <div class="shadow-overlay"></div>

    @foreach (var item in Model)
    {
          <div class="home-content">

            <div class="row home-content__main">

                <h3>@item.Title</h3>

                <h1>
                  @*   I am ipek *@
                    @item.Description
                </h1>

                <div class="home-content__buttons">
                    <a href="#works" class="smoothscroll btn btn--stroke">
